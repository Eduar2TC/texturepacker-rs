<?xml version="1.0" encoding="UTF-8"?>
<!--
  Manifiesto WiX v3 para el instalador .msi de TexturePacker-RS (x64).
  Instala tp-app y tp-cli en Archivos de programa, crea accesos directos
  en el menú Inicio y una entrada de desinstalación.

  El workflow sustituye @VERSION@ (ej. 0.2.0) y @EXE_APP@/@EXE_CLI@ por
  las rutas de los binarios compilados antes de invocar candle/light.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="TexturePacker-RS"
           Language="3082"
           Codepage="65001"
           Version="@VERSION@"
           Manufacturer="Eduar2TC"
           UpgradeCode="7C9B4E42-1F3A-4B8D-9C55-2A6E8D1F0B31">

    <!-- El resumen (summary information) solo admite páginas ANSI: texto
         ASCII plano aquí; los «» y — van en la base (Codepage 65001). -->
    <Package InstallerVersion="200"
             Compressed="yes"
             InstallScope="perMachine"
             Description="TexturePacker-RS - empaquetador de atlas de sprites" />
    <MajorUpgrade DowngradeErrorMessage="Ya hay una versión más reciente de [ProductName] instalada." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Eduar2TC/texturepacker-rs" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Eduar2TC/texturepacker-rs" />

    <Icon Id="AppIcon" SourceFile="packaging/windows/icon.ico" />

    <WixVariable Id="WixUILicenseRtf" Value="packaging/windows/licencia.rtf" />

    <Feature Id="Main" Title="TexturePacker-RS" Level="1">
      <ComponentGroupRef Id="Binarios" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="TexturePacker-RS" />
      </Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <ComponentGroup Id="Binarios" Directory="INSTALLFOLDER">
      <!-- Atajo advertised dentro del File: pasa ICE43/ICE57 con keypath
           de fichero por máquina. -->
      <Component Id="AppExe" Guid="*">
        <File Id="AppExeFile" Name="tp-app.exe" Source="@EXE_APP@" KeyPath="yes">
          <!-- Atajo directo en el menú Inicio (sin subcarpeta: evita el
               componente de limpieza y sus ICE38/ICE57). -->
          <Shortcut Id="AppShortcut"
                    Directory="ProgramMenuFolder"
                    Name="TexturePacker-RS"
                    Description="Empaquetador de atlas de sprites"
                    Advertise="yes" />
        </File>
      </Component>

      <Component Id="CliExe" Guid="*">
        <File Id="CliExeFile" Name="tp-cli.exe" Source="@EXE_CLI@" KeyPath="yes" />
        <!-- tp-cli al PATH del sistema para usarlo desde cualquier terminal. -->
        <Environment Id="CliPath" Name="PATH" Value="[INSTALLFOLDER]"
                     Permanent="no" Part="last" Action="set" System="yes" />
      </Component>
    </ComponentGroup>
  </Product>
</Wix>
